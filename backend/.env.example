# Copy to .env for local dev. In Render/staging/production, these are set
# as environment variables in the Render dashboard — never in a committed file.

ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256

# Database — local docker-compose Postgres by default.
# In staging/prod, this is the Supabase connection string (Settings > Database > Connection string > URI,
# swap "postgresql://" for "postgresql+asyncpg://").
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/proforce

# Redis — local docker-compose Redis by default.
# In staging/prod, this is the Upstash Redis REST/TCP URL.
REDIS_URL=redis://localhost:6379/0

# Object storage — Cloudflare R2 (S3-compatible). Leave blank locally;
# file upload endpoints will no-op until these are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=proforce-tooling
R2_PUBLIC_BASE_URL=
