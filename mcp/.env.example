# Copy to .env (same folder as this file) for local dev. Never commit the
# real .env — it holds the service account's real password.

# PF-AIR backend this server talks to. Defaults to the live Render
# deployment (the real Supabase data), since this project doesn't run the
# backend locally day to day. Swap to http://localhost:8000 only if you
# are actually running a local backend.
PFAIR_BASE_URL=https://proforce-tooling-api.onrender.com
PFAIR_API_PREFIX=/api/v1

# Dedicated service account credentials (see README.md's "Create the
# service account" section for how to create this user via POST /auth/signup).
# This account authenticates like any other PF-AIR user — it has no special
# role or DB access beyond what a regular `engineer` account can already see.
PFAIR_SERVICE_EMAIL=mcp-service@proforcedefence.com
PFAIR_SERVICE_PASSWORD=replace-with-the-service-account-password

# Path to the tool-call log file. Relative paths are resolved from this
# server's working directory (wherever Claude Desktop launches it from) —
# an absolute path is safer if you're not sure what that'll be.
PFAIR_LOG_FILE=./logs/tool_calls.log
